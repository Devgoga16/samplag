---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import empresas from '../assets/img/empresas.jpg';

const items = [
  'Fumigación y desratización periódica',
  'Limpieza programada de cisternas y tanques',
  'Mantenimiento de campanas y trampas de grasa',
  'Atención para una o varias sedes',
];
---
<section class="biz" id="empresas">
  <div class="container biz__in">
    <div class="biz__content">
      <span class="eyebrow eyebrow--light">Servicios empresariales</span>
      <h2>Programas de saneamiento para tu empresa</h2>
      <p>Mantén tus instalaciones en orden todo el año con un programa periódico. Coordinamos visitas según tu operación y te ayudamos a cumplir con las exigencias sanitarias de tu rubro.</p>
      <ul class="checks">
        {items.map((i) => <li><Icon name="check" />{i}</li>)}
      </ul>
      <button class="btn btn--green btn--lg" data-service="Programa de saneamiento para empresa"><Icon name="briefcase" /> Solicitar propuesta para mi empresa</button>
    </div>
    <div class="biz__media">
      <Image src={empresas} alt="Supervisores recorriendo un almacén industrial" widths={[560, 1200]} sizes="(max-width: 960px) 100vw, 560px" />
    </div>
  </div>
</section>
