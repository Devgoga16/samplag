---
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { site, waLink } from '../data/site';

interface Props {
  /** Mensaje prellenado de WhatsApp (las páginas de campaña lo personalizan por servicio) */
  waText?: string;
  /** Destino del botón "Cotizar" de la barra móvil */
  quoteHref?: string;
}
const { waText = 'Hola Samplag, quisiera una cotización.', quoteHref = '/#contacto' } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__in">
    <div class="footer__brand">
      <img src="/assets/logo-mark.png" alt="" width="815" height="545" class="footer__mark" loading="lazy" />
      <img src="/assets/logo-full-text-white.png" alt="Samplag, Saneamiento Ambiental y Control de Plagas S.A.C." class="footer__word" loading="lazy" />
      <p>Saneamiento ambiental y control de plagas para empresas y hogares. Autorizados por el Ministerio de Salud.</p>
    </div>
    <div class="footer__col">
      <h4>Servicios</h4>
      <a href="/fumigacion">Fumigación y desinsectación</a>
      <a href="/desratizacion">Desratización</a>
      <a href="/#servicios">Desinfección</a>
      <a href="/limpieza-de-cisternas">Cisternas y tanques</a>
      <a href="/#servicios">Campanas y trampas de grasa</a>
    </div>
    <div class="footer__col">
      <h4>Empresa</h4>
      <a href="/#nosotros">Nosotros</a>
      <a href="/#autorizaciones">Autorizaciones</a>
      <a href="/#empresas">Servicios empresariales</a>
      <a href="/#normativa">Normativa sanitaria</a>
      {site.storeEnabled && <a href="/tienda">Tienda en línea</a>}
      <a href="/#prevencion">Prevención</a>
      <a href="/#faq">Preguntas frecuentes</a>
    </div>
    <div class="footer__col">
      <h4>Contacto</h4>
      <a href={waLink()} target="_blank" rel="noopener">WhatsApp: {site.whatsappLabel}</a>
      <a href={`tel:${site.phone}`}>Teléfono: {site.phoneLabel}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {year} {site.name} Todos los derechos reservados. · RUC {site.ruc ?? <Placeholder light>por confirmar</Placeholder>}</span>
    <span>{site.authorization} · <a href="/privacidad">Política de privacidad</a></span>
  </div>
</footer>

<!-- WhatsApp flotante (desktop) y barra inferior (móvil) -->
<a class="wa-float" href={waLink(waText)} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"><Icon name="whatsapp" /></a>
<nav class="mbar" aria-label="Contacto rápido">
  <a href={`tel:+${site.whatsapp}`}><Icon name="phone" />Llamar</a>
  <a href={waLink(waText)} target="_blank" rel="noopener" class="mbar__wa"><Icon name="whatsapp" />WhatsApp</a>
  <a href={quoteHref}><Icon name="file" />Cotizar</a>
</nav>
