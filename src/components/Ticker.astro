---
import Icon from './Icon.astro';

const items = ['Fumigación integral', 'Desratización', 'Desinfección', 'Limpieza de cisternas', 'Tanques elevados', 'Campanas extractoras', 'Trampas de grasa', 'Limpieza industrial', 'Control aviar'];
// Se duplica la lista para que la animación sea continua
const loop = [...items, ...items];
---
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {loop.map((item) => <Fragment><span>{item}</span><Icon name="leaf" /></Fragment>)}
  </div>
</div>
