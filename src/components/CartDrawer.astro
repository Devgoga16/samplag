---
// Carrito lateral: presente en todas las páginas para que el pedido se mantenga al navegar
---
<div class="drawer" id="cart" aria-hidden="true">
  <div class="drawer__overlay" data-cart-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <header class="drawer__head">
      <h2 id="cart-title">Tu pedido</h2>
      <button type="button" class="drawer__close" data-cart-close aria-label="Cerrar carrito">
        <svg class="ic" aria-hidden="true"><use href="#i-x" /></svg>
      </button>
    </header>
    <div class="drawer__body" id="cart-body"></div>
    <footer class="drawer__foot" id="cart-foot"></footer>
  </aside>
</div>

<script>
  import '../scripts/store';
</script>
