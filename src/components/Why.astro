---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import tecnico from '../assets/img/tecnico.jpg';

const feats = [
  { icon: 'award', title: 'Experiencia comprobada', text: 'Más de una década atendiendo necesidades de saneamiento.' },
  { icon: 'shield', title: 'Autorización sanitaria', text: 'Autorizados por el Ministerio de Salud a través de la DIRIS Lima Sur.' },
  { icon: 'map', title: 'Cobertura nacional', text: 'Atendemos en Lima y coordinamos servicios a nivel nacional.' },
  { icon: 'zap', title: 'Atención rápida', text: 'Cotiza por WhatsApp y coordina el servicio en el horario que te acomode.' },
];
---
<section class="section" id="nosotros">
  <div class="container why">
    <div class="why__media">
      <Image src={tecnico} alt="Técnico con traje de protección, lentes y respirador" widths={[560, 1100]} sizes="(max-width: 960px) 100vw, 560px" />
      <div class="why__card">
        <Icon name="leaf" />
        <div>
          <b>Cuidado ambiental</b>
          <span>Aplicación responsable con las personas y el entorno.</span>
        </div>
      </div>
    </div>
    <div class="why__content">
      <span class="eyebrow">¿Por qué Samplag?</span>
      <h2>Tu aliado para mantener espacios sanos y seguros</h2>
      <p>En <b>Samplag S.A.C.</b> somos una empresa especializada en saneamiento ambiental y control de plagas, con más de 15 años de experiencia en el mercado. Estamos comprometidos con el cuidado ambiental de tu empresa y de tu hogar.</p>
      <ul class="feats">
        {feats.map((f) => (
          <li><span class="feats__ic"><Icon name={f.icon} /></span><div><b>{f.title}</b><span>{f.text}</span></div></li>
        ))}
      </ul>
      <a href="#contacto" class="btn btn--navy">Conversemos sobre tu local <Icon name="arrow" /></a>
    </div>
  </div>
</section>
