---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Services from '../components/Services.astro';
import Pests from '../components/Pests.astro';
import Sectors from '../components/Sectors.astro';
import Why from '../components/Why.astro';
import Process from '../components/Process.astro';
import Authorizations from '../components/Authorizations.astro';
import Normativa from '../components/Normativa.astro';
import Business from '../components/Business.astro';
import Prevention from '../components/Prevention.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Fumigación y Limpieza de Cisternas en Lima · Autorizada por MINSA | Samplag"
  description="Empresa de saneamiento ambiental autorizada por el Ministerio de Salud (R.A. 305-2020-DSAIA-DIRIS-LS). Fumigación, desratización, cisternas, campanas y trampas de grasa. Cotiza gratis por WhatsApp."
  ogTitle="Samplag · Saneamiento con respaldo MINSA"
  ogDescription="Fumigación, desratización, limpieza de cisternas, campanas y trampas de grasa en Lima. Empresa autorizada por el Ministerio de Salud con más de 10 años de experiencia."
>
  <Header />
  <main>
    <Hero />
    <Ticker />
    <Services />
    <Pests />
    <Sectors />
    <Why />
    <Process />
    <Authorizations />
    <Normativa />
    <Business />
    <Prevention />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>
