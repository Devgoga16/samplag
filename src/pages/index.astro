---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Services from '../components/Services.astro';
import AvianControl from '../components/AvianControl.astro';
import Pests from '../components/Pests.astro';
import Sectors from '../components/Sectors.astro';
import Why from '../components/Why.astro';
import Process from '../components/Process.astro';
import Authorizations from '../components/Authorizations.astro';
import Normativa from '../components/Normativa.astro';
import Business from '../components/Business.astro';
import StoreTeaser from '../components/StoreTeaser.astro';
import Prevention from '../components/Prevention.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { loadCatalog } from '../data/store';
import { site } from '../data/site';

// Con la tienda apagada no se consulta el catálogo de uTracker
const catalog = site.storeEnabled ? await loadCatalog() : null;
---
<Layout
  title="Fumigación y Limpieza de Cisternas en Lima · Autorizada por MINSA | Samplag"
  description="Fumigación, desratización y limpieza de cisternas en Lima con certificado en cada servicio. Empresa autorizada por el MINSA (R.A. 2764-2021-DSAIA/DIRIS-LC). Cotiza gratis por WhatsApp."
  ogTitle="Samplag · Saneamiento con respaldo MINSA"
  ogDescription="Fumigación, desratización, limpieza de cisternas, campanas y trampas de grasa en Lima, con certificado en cada servicio. Empresa autorizada por el Ministerio de Salud con más de 15 años de experiencia."
>
  <Header />
  <main>
    <Hero />
    <Ticker />
    <Services />
    <AvianControl />
    <Pests />
    <Sectors />
    <Why />
    <Process />
    <Authorizations />
    <Normativa />
    <Business />
    {catalog && <StoreTeaser catalog={catalog} />}
    <Prevention />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Layout>

<script>
  import '../scripts/landing';
</script>
